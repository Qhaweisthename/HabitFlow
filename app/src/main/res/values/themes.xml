<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Base app theme -->
    <style name="Base.Theme.HabitFlow" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Plain white background -->
        <item name="android:windowBackground">@android:color/white</item>
    </style>

    <!-- Settings Row Button -->
    <style name="Widget.Settings.RowButton" parent="Widget.Material3.Button.TextButton">
        <!-- Proper size -->
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>

        <!-- Padding -->
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:paddingStart">40dp</item>
        <item name="android:insetRight">16dp</item>

        <!-- Text style -->
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@android:color/black</item>

        <!-- Transparent so card shows through -->
        <item name="backgroundTint">@android:color/transparent</item>

        <!-- Ripple effect -->
        <item name="rippleColor">@android:color/white</item>

        <!-- Align text left, vertically centered -->
        <item name="android:gravity">start|center_vertical</item>
    </style>

    <!-- Final app theme -->
    <style name="Theme.HabitFlow" parent="Base.Theme.HabitFlow" />

</resources>
