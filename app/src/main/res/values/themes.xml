<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Base app theme -->
    <style name="Base.Theme.HabitFlow" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Plain background -->
        <item name="android:windowBackground">@android:color/white</item>
    </style>

    <!-- Row button style used in fragment_settings.xml -->
    <style name="Widget.Settings.RowButton" parent="Widget.Material3.Button.TextButton">
        <!-- ✅ Give the button a width & height -->
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>

        <item name="android:insetRight">16dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:paddingStart">40dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@android:color/black</item>

        <!-- Keep background transparent so the card colour shows -->
        <item name="backgroundTint">@android:color/transparent</item>
        <item name="rippleColor">@android:color/white</item>
        <item name="android:gravity">start|center_vertical</item>
    </style>

    <!-- Final app theme -->
    <style name="Theme.HabitFlow" parent="Base.Theme.HabitFlow" />

</resources>